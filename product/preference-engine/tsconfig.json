{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "../extension/src/engine",
    "outDir": "dist"
  },
  "include": ["../extension/src/engine/*.ts"]
}
