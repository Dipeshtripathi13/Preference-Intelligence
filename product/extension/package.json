{
  "name": "preference-intelligence-extension",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:engine && vite build && esbuild src/background.ts --bundle --format=iife --target=chrome120 --outfile=dist/background.js && esbuild src/content/index.ts --bundle --format=iife --target=chrome120 --outfile=dist/content.js",
    "build:engine": "tsc -p ../preference-engine/tsconfig.json && esbuild src/engine/index.ts --bundle --format=esm --platform=neutral --target=es2022 --sourcemap --outfile=../preference-engine/dist/index.js",
    "dev": "vite",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@testing-library/react": "^16.3.0",
    "@types/chrome": "^0.1.1",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "esbuild": "^0.25.9",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.2.2",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vitest": "^5.0.0"
  }
}
