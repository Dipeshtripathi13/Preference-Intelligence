# Copy to research/.env only for local use. The runner does not load .env files;
# export values in your shell or use an audited secret manager.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Local provider expects an OpenAI-compatible endpoint. A key is optional.
LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434
LOCAL_MODEL_API_KEY=

# Optional API-version overrides.
ANTHROPIC_API_VERSION=2023-06-01
GEMINI_API_VERSION=v1beta
