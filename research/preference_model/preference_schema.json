{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://preference-intelligence.dev/schema/preference-record/0.1.0",
  "title": "Preference Intelligence Record",
  "description": "A provider-independent, scoped, explainable response-preference record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "preference_id",
    "dimension",
    "value",
    "scope",
    "confidence",
    "state",
    "source_type",
    "evidence_count",
    "created_at",
    "updated_at",
    "last_observed_at",
    "decay",
    "user_locked",
    "evidence",
    "provenance"
  ],
  "properties": {
    "preference_id": { "type": "string", "format": "uuid" },
    "dimension": {
      "oneOf": [
        {
          "enum": [
            "verbosity",
            "technical_depth",
            "explanation_level",
            "code_preference",
            "example_preference",
            "analogy_preference",
            "format_preference",
            "step_by_step_preference",
            "tone",
            "math_depth",
            "citation_preference",
            "answer_first_preference"
          ]
        },
        { "type": "string", "pattern": "^x-[a-z0-9][a-z0-9._-]*$" }
      ]
    },
    "value": {
      "oneOf": [
        { "type": "string", "maxLength": 160 },
        { "type": "number" },
        { "type": "boolean" },
        {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "maxLength": 80 }
        }
      ]
    },
    "scope": { "$ref": "#/$defs/scope" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "state": { "enum": ["inferred", "confirmed", "locked", "suppressed", "ambiguous"] },
    "source_type": {
      "enum": ["dashboard_edit", "user_explicit", "user_correction", "user_implicit", "imported", "experiment"]
    },
    "evidence_count": { "type": "integer", "minimum": 0 },
    "independent_interaction_count": { "type": "integer", "minimum": 0, "default": 0 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "last_observed_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": ["string", "null"], "format": "date-time", "default": null },
    "decay": { "$ref": "#/$defs/decay" },
    "user_locked": { "type": "boolean" },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/provenance" }
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "subdomain", "task"],
      "properties": {
        "domain": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "subdomain": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "task": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9._-]*$" }
      }
    },
    "decay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "half_life_days"],
      "properties": {
        "mode": { "enum": ["exponential", "none"] },
        "half_life_days": { "type": ["number", "null"], "exclusiveMinimum": 0 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "event_id",
        "author",
        "polarity",
        "explicitness",
        "strength",
        "source_type",
        "observed_at",
        "scope_at_observation",
        "capture"
      ],
      "properties": {
        "evidence_id": { "type": "string", "format": "uuid" },
        "event_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "author": { "const": "user" },
        "polarity": { "enum": ["positive", "negative"] },
        "explicitness": { "enum": ["explicit", "correction", "implicit"] },
        "strength": { "type": "number", "minimum": 0, "maximum": 1 },
        "source_type": {
          "enum": ["dashboard_edit", "user_explicit", "user_correction", "user_implicit", "imported", "experiment"]
        },
        "signal_label": { "type": ["string", "null"], "maxLength": 120 },
        "raw_excerpt": { "type": ["string", "null"], "maxLength": 500, "default": null },
        "observed_at": { "type": "string", "format": "date-time" },
        "scope_at_observation": { "$ref": "#/$defs/scope" },
        "capture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mechanism", "provider", "trusted_user_surface"],
          "properties": {
            "mechanism": { "enum": ["dashboard", "provider_composer", "profile_import", "synthetic_experiment"] },
            "provider": { "type": ["string", "null"], "maxLength": 80 },
            "trusted_user_surface": { "const": true }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "component", "recorded_at"],
      "properties": {
        "actor": { "enum": ["user", "local_inference", "import"] },
        "component": { "type": "string", "minLength": 1, "maxLength": 120 },
        "version": { "type": ["string", "null"], "maxLength": 40 },
        "recorded_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
